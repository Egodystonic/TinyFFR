<UserControl
    x:Class="TinyFFR.Tests.Integrations.Wpf.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tffrWpf="clr-namespace:Egodystonic.TinyFFR.Wpf;assembly=TinyFFR.Wpf"
    xmlns:vm="clr-namespace:TinyFFR.Tests.Integrations.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1400"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,12,0,2" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Padding" Value="4,3" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Margin" Value="0,4" />
                    </Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="Margin" Value="0,2" />
                    </Style>
                    <Style TargetType="Slider">
                        <Setter Property="Margin" Value="0,2" />
                    </Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Height" Value="8" />
                        <Setter Property="Margin" Value="0,2" />
                    </Style>
                </StackPanel.Resources>

                <TextBlock Margin="0,0,0,2" Style="{StaticResource SectionHeader}" Text="Rendering" />
                <Button Command="{Binding ToggleRenderingCommand}" Content="Start / stop rendering" />
                <CheckBox Content="Animate (render every tick)" IsChecked="{Binding Animate}" />
                <Button Command="{Binding RenderOnceCommand}" Content="Render once" />
                <CheckBox Content="Composite mode" IsChecked="{Binding UseCompositor}" />
                <CheckBox Content="Overlay enabled" IsChecked="{Binding OverlayEnabled}" IsEnabled="{Binding UseCompositor}" />
                <TextBlock Text="Internal render resolution" />
                <ComboBox
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding ResolutionOptions}"
                    SelectedItem="{Binding SelectedResolution}" />
                <TextBlock Text="Max internal render resolution" />
                <ComboBox
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding MaxResolutionOptions}"
                    SelectedItem="{Binding SelectedMaxResolution}" />

                <TextBlock Style="{StaticResource SectionHeader}" Text="Model" />
                <TextBlock FontSize="11" Text="{Binding LoadProgressText}" TextWrapping="Wrap" />
                <ProgressBar
                    Maximum="{Binding TotalModelCount}"
                    Minimum="0"
                    Value="{Binding LoadedModelCount}" />
                <ListBox
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding CatalogItems}"
                    SelectedItem="{Binding SelectedModel}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Opacity" Value="0.65" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Style="{StaticResource SectionHeader}" Text="Transform" />
                <CheckBox Content="Spin X" IsChecked="{Binding SpinX}" />
                <CheckBox Content="Spin Y" IsChecked="{Binding SpinY}" />
                <CheckBox Content="Spin Z" IsChecked="{Binding SpinZ}" />

                <TextBlock Style="{StaticResource SectionHeader}" Text="Shading" />
                <ComboBox ItemsSource="{Binding ShadingStyles}" SelectedItem="{Binding ShadingStyle}" />
                <CheckBox Content="Opaque random colors" IsChecked="{Binding RandomColorOpaque}" />
                <Button Command="{Binding RandomizeColorCommand}" Content="Randomize color" />

                <TextBlock Style="{StaticResource SectionHeader}" Text="Lighting" />
                <TextBlock Text="Camera light brightness" />
                <Slider Maximum="1" Minimum="0" Value="{Binding CameraLightBrightness}" />
                <CheckBox Content="Sunlight" IsChecked="{Binding SunEnabled}" />
                <CheckBox Content="Sunlight casts shadows" IsChecked="{Binding SunCastsShadows}" IsEnabled="{Binding SunEnabled}" />
                <TextBlock Text="Sunlight brightness" />
                <Slider Maximum="3" Minimum="0" Value="{Binding SunBrightness}" IsEnabled="{Binding SunEnabled}" />
                <Button Command="{Binding ShiftLightHueCommand}" Content="Shift light hue" />

                <TextBlock Style="{StaticResource SectionHeader}" Text="Backdrop" />
                <ComboBox ItemsSource="{Binding BackdropModes}" SelectedItem="{Binding BackdropMode}" />
                <TextBlock Text="Backdrop intensity" />
                <Slider Maximum="3" Minimum="0" Value="{Binding BackdropIntensity}" />

                <TextBlock Style="{StaticResource SectionHeader}" Text="Quality" />
                <ComboBox ItemsSource="{Binding QualityPresets}" SelectedItem="{Binding Quality}" />

                <Expander Header="Loaded resources" Margin="0,12,0,0">
                    <TextBox
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="Consolas"
                        FontSize="11"
                        IsReadOnly="True"
                        MaxHeight="300"
                        Text="{Binding ResourceListing, Mode=OneWay}"
                        VerticalScrollBarVisibility="Auto" />
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <GridSplitter
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <Grid Grid.Column="2">
            <tffrWpf:TinyFfrSceneView
                x:Name="SceneView"
                Compositor="{Binding Compositor}"
                FallbackBrush="LightGray"
                InternalRenderResolution="{Binding InternalRenderResolution}"
                InternalRenderResolutionMax="{Binding InternalRenderResolutionMax}"
                Renderer="{Binding Renderer}" />
            <Border
                Background="#B0000000"
                IsHitTestVisible="False"
                Visibility="{Binding IsAwaitingFirstModel, Converter={StaticResource BoolToVis}}">
                <TextBlock
                    FontSize="20"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    Text="Waiting for the first model to finish loading..."
                    VerticalAlignment="Center" />
            </Border>
            <Border
                Background="#A0000000"
                HorizontalAlignment="Stretch"
                IsHitTestVisible="False"
                Padding="8,4"
                VerticalAlignment="Bottom">
                <TextBlock Foreground="White" Text="{Binding StatusText}" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
